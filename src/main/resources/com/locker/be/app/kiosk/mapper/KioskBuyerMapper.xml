<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.locker.be.app.kiosk.mapper.KioskBuyerMapper">

    <select id="lockerListBuyer" resultType="com.locker.be.app.kiosk.dto.KioskBuyerQueryDto$KioskLockerRes" parameterType="com.locker.be.app.kiosk.dto.KioskBuyerQueryDto$KioskLockerReq">
        EXECUTE SP_KIOSK_BUYER_LOCKER_SELECT
            #{TRADE_ID}
            , #{AUTH_CODE}
            , #{KIOSK_CODE}
    </select>

    <select id="productListBuyer" resultType="com.locker.be.app.kiosk.dto.KioskBuyerQueryDto$KioskProductRes" parameterType="com.locker.be.app.kiosk.dto.KioskBuyerQueryDto$KioskProductReq">
        EXECUTE SP_KIOSK_BUYER_PRODUCT_SELECT
            #{AUTH_CODE}
            , #{KIOSK_CODE}
    </select>
</mapper>