<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.locker.be.user.mapper.UserMapper">

    <update id="update" parameterType="com.locker.be.user.dto.UserDto$UserUpdateReq">
        EXECUTE SP_USER_UPDATE
            #{USER_ID}
            ,#{NICKNAME}
    </update>

    <update id="banned" parameterType="com.locker.be.user.dto.UserDto$UserBannedReq">
        EXECUTE SP_USER_BANNED
            #{USER_ID}
    </update>

    <update id="delete" parameterType="com.locker.be.user.dto.UserDto$UserDeleteReq">
        EXECUTE SP_USER_DELETE
            #{USER_ID}
    </update>
</mapper>